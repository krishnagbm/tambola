# Supabase Configuration
# Replace with your Supabase Project URL and Anon/Public Key from Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
APP_BASE_URL=https://www.dabhousie.com
SUPPORT_EMAIL=contact@dabhousie.com

# Web Purchase Configuration
PURCHASE_ENABLED=true
PURCHASE_BASE_URL="https://www.dabhousie.com/#/wallet"
APP_ENVIRONMENT=development
ENABLE_MOCK_CREDITS=true
