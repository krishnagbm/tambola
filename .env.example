# Supabase Configuration
# Replace with your Supabase Project URL and Anon/Public Key from Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Web Purchase Configuration (Configurable handoff per Master README & Addendum v1.1)
PURCHASE_ENABLED=true
PURCHASE_BASE_URL=https://digitalappstudio.com/tambola/buy-credits
APP_ENVIRONMENT=development
ENABLE_MOCK_CREDITS=true
