# =====================================================================
# DabHousie — Environment Configuration Template (.env)
# =====================================================================

# ── 1. Supabase Configuration ───────────────────────────────────────
# Project Settings -> API
SUPABASE_URL=https://itfcnurjrnyalauwwdkj.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── 2. App & Domain Configuration ───────────────────────────────────
APP_BASE_URL=https://www.dabhousie.com
BASE_URL=https://www.dabhousie.com
SUPPORT_EMAIL=contact@dabhousie.com
SES_FROM_EMAIL=receipts@dabhousie.com
AWS_SES_REGION=us-east-1

# ── 3. Web Purchase & Checkout Configuration ────────────────────────
PURCHASE_ENABLED=true
PURCHASE_BASE_URL=https://www.dabhousie.com/pricing.html
CHECKOUT_API_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/Prod/checkout
APP_ENVIRONMENT=development
ENABLE_MOCK_CREDITS=true

# ── 4. Stripe API Keys (DabHousie Account) ─────────────────────────
# Test Keys: sk_test_... | Live Keys: sk_live_...
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ── 5. Stripe Product Price IDs ─────────────────────────────────────
# Created in Stripe Dashboard -> Product Catalog
STRIPE_PRICE_STARTER=price_starter_id_here
STRIPE_PRICE_FAMILY=price_family_id_here
STRIPE_PRICE_STANDARD=price_standard_id_here
STRIPE_PRICE_PARTY=price_party_id_here
STRIPE_PRICE_PRO=price_pro_id_here
STRIPE_PRICE_GALA=price_gala_id_here
STRIPE_PRICE_MEGA=price_mega_id_here
